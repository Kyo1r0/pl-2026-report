<div .container>
    <h1>一言掲示板

    <h2>投稿する
    <form method=post action=@{HomeR} enctype=#{formEnctype}>
        ^{formWidget}
        <button type=submit>投稿

    <h2>投稿一覧
    $if null allComments
        <p>まだ投稿がありません。
    $else
        <ul>
            $forall Entity _ comment <- allComments
                <li>#{commentMessage comment}